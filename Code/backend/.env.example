# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (LLD §1 — all app tables live in one database)
DATABASE_URL=postgres://user:password@localhost:5432/donation_app_dev

# Firebase Auth (HLD §3 chosen auth provider; LLD §3 bearer-token sessions)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (HLD §3 chosen media storage; LLD §1.3/§1.5 photo_url fields)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Government NGO Verification Source (spec.md §10 open item — exact provider not yet decided;
# these are placeholders for the verifyNgo() integration seam in LLD §3.2)
GOV_VERIFICATION_API_BASE_URL=
GOV_VERIFICATION_API_KEY=
