# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=

# PostgreSQL (LLD §1 — all app tables live in one database)
DATABASE_URL=postgres://user:password@localhost:5432/donation_app_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Test database (task 12.3) — separate from DATABASE_URL above so running
# `npm test` (scripts/run-tests.js) never touches dev data. Migrated and
# truncated to a clean slate automatically before every test run; only needs
# to exist (or be creatable by this user) once.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/donation_app_test

# Firebase Auth (HLD §3 chosen production auth provider; LLD §3 bearer-token
# sessions). NOT required for local development (Task 13A) — leave blank.
# Only needed if/when Task 13B evaluates and configures real Firebase Auth.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session tokens (task 2.9 — self-issued JWT; this IS the live auth mechanism
# for local development, Task 13A, not just a placeholder — see
# src/services/sessionToken.js). Required. Use a long random string.
JWT_SECRET=

# Image storage driver (Task 13A/13B seam — src/services/imageStorage.js):
#   local       (default) — saves uploaded photos under backend/uploads/,
#                no cloud account needed. This is what local dev (13A) uses.
#   cloudinary  — uses the CLOUDINARY_* credentials below (production, 13B).
#   s3          — uploads to a private S3 bucket; CloudFront serves image URLs.
IMAGE_STORAGE_DRIVER=local

# Amazon S3 (production). The ECS task role needs s3:PutObject on this bucket's
# uploads/* prefix. The bucket stays private; S3_PUBLIC_BASE_URL is the HTTPS
# CloudFront distribution configured with Origin Access Control for this bucket.
AWS_REGION=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

# Cloudinary (HLD §3 chosen production media storage; LLD §1.3/§1.5 photo_url
# fields). Optional legacy driver; only required when IMAGE_STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=n1ylmg4w
CLOUDINARY_API_KEY=991383345321664
CLOUDINARY_API_SECRET=jFTUnMNSjdB0l3Z-ifDBO0OsLKw

# Government NGO Verification Source (spec.md §10 open item — exact provider not yet decided;
# these are placeholders for the verifyNgo() integration seam in LLD §3.2)
GOV_VERIFICATION_API_BASE_URL=
GOV_VERIFICATION_API_KEY=

# Claim expiry background job (task 6.1; LLD §4 — default 5 min, sufficient
# given the 48h claim expiry window). Milliseconds.
CLAIM_EXPIRY_JOB_INTERVAL_MS=300000

# Forgot-password reset links point back at this origin (src/services/messageDelivery.js).
# Actual code/link "delivery" is a console-log dev stub — no email/SMS
# provider account needed locally; see that file's header comment.
FRONTEND_BASE_URL=http://localhost:5173
